# Copy to .env (chmod 600). Never commit it.
CAMERA_PASSWORD=
# Home Assistant long-lived access token (Profile -> Security -> Long-lived access tokens)
HA_TOKEN=
TZ=America/Los_Angeles
# Speeding alerts (optional): a channel webhook is simplest (Channel settings -> Integrations -> Webhooks)
DISCORD_WEBHOOK_URL=
# ...or a bot token plus alert.channel in config.json
DISCORD_BOT_TOKEN=
